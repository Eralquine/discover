# ---------------------------------------------------------------------------
# Storage (see README "Where does the data live" for the recommended setup)
# ---------------------------------------------------------------------------
# Any SQLAlchemy-compatible URL. Defaults to a local SQLite file for
# development. For production, point this at a managed Postgres instance
# (e.g. a free Supabase project) so the data lives durably on the internet:
#   postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./soc.db

# ---------------------------------------------------------------------------
# Microsoft 365 / Entra ID (Office 365 Management Activity API)
# ---------------------------------------------------------------------------
# App registration in Entra ID (Azure AD) with Application permission
# "ActivityFeed.Read" (Office 365 Management APIs) granted with admin
# consent. See README "Microsoft 365 setup".
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Comma-separated list of content types to subscribe to.
M365_CONTENT_TYPES=Audit.AzureActiveDirectory,Audit.Exchange,Audit.General
# How often to poll for new audit content, in seconds.
M365_POLL_INTERVAL_SECONDS=300

# ---------------------------------------------------------------------------
# Fortinet FortiGate syslog listener
# ---------------------------------------------------------------------------
# UDP/TCP address the tool listens on for syslog sent by the FortiGate.
# Configure the FortiGate under Log & Report > Log Settings > Remote Logging
# to send here (recommend TCP+TLS in production; see README).
FORTINET_SYSLOG_HOST=0.0.0.0
FORTINET_SYSLOG_PORT=5514
FORTINET_SYSLOG_PROTOCOL=udp

# ---------------------------------------------------------------------------
# Alerting (outbound email)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_FROM_ADDRESS=soc-alerts@example.com

# Internal SOC team recipients (always notified), comma-separated.
ALERT_INTERNAL_RECIPIENTS=you@example.com

# Minutes to suppress a repeat of the same rule+group before alerting again.
ALERT_COOLDOWN_MINUTES=30
